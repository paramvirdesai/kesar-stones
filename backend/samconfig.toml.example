# Copy to samconfig.toml and adjust, or run: sam deploy --guided
#
# After deploy, copy LeadApiBaseUrl from stack Outputs into:
#   src/environments/environment.production.ts → apiBaseUrl

version = 0.1

[default.deploy.parameters]
stack_name = "iconic-stones-leads"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
region = "ap-south-1"
confirm_changeset = true
parameter_overrides = "FromEmail=info@theiconicstones.com RecipientEmail=info@theiconicstones.com"
