{
  "name": "marble-granite-site",
  "version": "1.0.0",
  "description": "Luxury stone Angular + Tailwind MVP",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "backend:install": "npm install --prefix backend/lambda/lead",
    "backend:build": "cd backend && sam build",
    "backend:deploy": "cd backend && sam build && sam deploy",
    "hosting:deploy": "aws cloudformation deploy --template-file hosting/template.yaml --stack-name iconic-stones-site --region us-east-1 --capabilities CAPABILITY_IAM --no-fail-on-empty-changeset --parameter-overrides SiteDomainName=www.theiconicstones.com ApexDomainName=theiconicstones.com AcmCertificateArn=arn:aws:acm:us-east-1:019847571143:certificate/c70ea148-e72c-4d68-a895-7b8fa8a92680",
    "domain:setup": "bash scripts/setup-custom-domain.sh",
    "site:deploy": "bash scripts/deploy-site.sh",
    "production:deploy": "npm run hosting:deploy && npm run site:deploy"
  },
  "keywords": [
    "angular",
    "tailwind",
    "luxury-stone"
  ],
  "author": "Cursor Agent",
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "gsap": "^3.15.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "5.4"
  }
}
